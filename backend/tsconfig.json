{
	"compilerOptions": {
		"target": "ES2024",
		"module": "nodenext",
		"types": ["node"],
		"strict": true,
		"skipLibCheck": true,
		// Node runs src/ directly by stripping types: tsc only typechecks,
		// and must reject syntax Node cannot strip (enums, parameter properties...)
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true
	},
	"include": ["src"]
}
