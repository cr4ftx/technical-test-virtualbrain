# Copy to .env (gitignored) and fill in

# Port the API listens on
PORT=3001

# Allowed CORS origin, any origin when unset
CORS_ORIGIN=http://localhost:5173

# VirtualBrain chatbot API token
VIRTUALBRAIN_TOKEN=your-token-here

# How battles are played: one-shot (the chatbot narrates the whole battle, needs VIRTUALBRAIN_TOKEN)
# or turn-based (round by round, computed by the battle engine). one-shot when unset
BATTLE_MODE=one-shot
