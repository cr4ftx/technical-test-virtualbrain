# Copy to .env (gitignored) and fill in

# Port the API listens on
PORT=3001

# Allowed CORS origin, any origin when unset
CORS_ORIGIN=http://localhost:5173

# VirtualBrain chatbot API token
VIRTUALBRAIN_TOKEN=your-token-here

# How battles are played, both need VIRTUALBRAIN_TOKEN: one-shot (the chatbot narrates the whole battle)
# or turn-based (round by round: the chatbot picks the moves, the battle engine computes them). one-shot when unset
BATTLE_MODE=one-shot
