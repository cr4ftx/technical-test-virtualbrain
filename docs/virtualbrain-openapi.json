{"openapi":"3.0.0","paths":{"/v1/auth/api-key/token":{"post":{"description":"Exchanges a VirtualBrain API key for an access token and refresh token. The access token expires after 1 hour.","operationId":"ApiKeyAuthController_exchangeToken_v1","parameters":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiKeyExchangeTokenBody"}}}},"responses":{"200":{"description":"Token pair returned","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiKeyTokenResponse"}}}},"401":{"description":"Invalid or revoked API key"},"429":{"description":"Too Many Requests"}},"summary":"Exchange API key for tokens","tags":["API Key Auth"]}},"/v1/auth/api-key/refresh":{"post":{"description":"Exchanges a refresh token for a new access token and refresh token pair. Token rotation is enforced.","operationId":"ApiKeyAuthController_refreshToken_v1","parameters":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiKeyRefreshTokenBody"}}}},"responses":{"200":{"description":"New token pair returned","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiKeyTokenResponse"}}}},"401":{"description":"Invalid or expired refresh token, or API key revoked"},"429":{"description":"Too Many Requests"}},"summary":"Refresh access token","tags":["API Key Auth"]}},"/v1/auth/{id}":{"post":{"description":"Creates a new anonymous session and returns a JWT token, for public chatbots","operationId":"AuthController_login_v1","parameters":[{"name":"id","required":true,"in":"path","description":"Chatbot ID to authenticate with","schema":{"example":"123e4567-e89b-12d3-a456-426614174000","type":"string"}}],"responses":{"200":{"description":"Successfully authenticated","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AuthResponse"}}}},"404":{"description":"Chatbot not found"},"429":{"description":"Too Many Requests"}},"summary":"Authenticate with a chatbot","tags":["Auth"]}},"/v1/auth/{id}/preview":{"post":{"description":"Creates a preview session for authenticated users","operationId":"AuthController_loginPreview_v1","parameters":[{"name":"id","required":true,"in":"path","description":"Chatbot ID to authenticate with","schema":{"example":"123e4567-e89b-12d3-a456-426614174000","type":"string"}}],"responses":{"200":{"description":"Successfully authenticated in preview mode","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AuthResponse"}}}},"401":{"description":"Unauthorized"},"404":{"description":"Chatbot not found"},"429":{"description":"Too Many Requests"}},"security":[{"bearer":[]}],"summary":"Authenticate in preview mode","tags":["Auth"]}},"/v1/chats/{id}":{"get":{"description":"Retrieves chatbot configuration and metadata","operationId":"ChatbotController_getChatbot_v1","parameters":[{"name":"id","required":true,"in":"path","description":"Chatbot UUID identifier","schema":{"example":"123e4567-e89b-12d3-a456-426614174000","type":"string"}}],"responses":{"200":{"description":"Chatbot details retrieved successfully","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChatbotDto"}}}},"401":{"description":"Unauthorized"},"404":{"description":"Chatbot not found"},"429":{"description":"Too Many Requests"}},"security":[{"bearer":[]}],"summary":"Get chatbot details","tags":["Chatbots"]}},"/v1/chats/{id}/messages":{"get":{"description":"Retrieves all messages for a chatbot session","operationId":"ChatbotController_getMessages_v1","parameters":[{"name":"id","required":true,"in":"path","description":"Chatbot UUID identifier","schema":{"example":"123e4567-e89b-12d3-a456-426614174000","type":"string"}},{"name":"x-session-id","in":"header","description":"Use Chatbot session ID header to get messages.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Messages retrieved successfully","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/compo