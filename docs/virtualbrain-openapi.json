n":"The query text to send to the chatbot","example":"What is the refund policy?"}},"required":["query"]},"HealthCheckResponse":{"type":"object","properties":{"status":{"type":"string","enum":["running","stopped","upgrading"]},"version":{"type":"string"},"mode":{"type":"string","enum":["development","production","staging"]}},"required":["status","version","mode"]}}},"x-guides":[{"title":"Getting Started","file":"getting-started.md"}],"x-rate-limits":{"ipShort":"10 req / 1s","ipMedium":"60 req / 10s","ipLong":"160 req / 60s","chatbot":"1000 req / 60s"}}
